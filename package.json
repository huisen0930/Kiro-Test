{
  "name": "focusflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A task + focus-session tracker REST API, built to showcase Kiro's spec-driven workflow.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "sync:issues": "node scripts/sync-spec-issues.mjs"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
